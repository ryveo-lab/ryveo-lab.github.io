---
import { Reveal } from '../components/Reveal';
import type { AboutCopy } from '../i18n/content';

interface Props {
  content: AboutCopy;
}

const { content } = Astro.props;
---

<section id="about" class="scroll-mt-16 px-5 pb-28 md:px-8 md:pb-40">
  <div class="mx-auto max-w-3xl">
    <Reveal client:visible>
      <h2
        class="font-display text-3xl font-medium tracking-tight md:text-5xl"
      >
        {content.heading}
      </h2>
    </Reveal>
    {
      content.body.map((paragraph, index) => (
        <Reveal client:visible delay={0.1 + index * 0.1}>
          <p class="mt-6 text-base leading-relaxed text-muted md:text-lg">
            {paragraph}
          </p>
        </Reveal>
      ))
    }
  </div>
</section>
