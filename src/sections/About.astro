---
import { Reveal } from '../components/Reveal';
import type { AboutCopy } from '../i18n/content';

interface Props {
  content: AboutCopy;
}

const { content } = Astro.props;
---

<section id="about" class="scroll-mt-28 px-5 py-32 md:px-8 md:py-44">
  <div class="mx-auto max-w-3xl">
    <Reveal client:visible>
      <p class="kicker">{content.kicker}</p>
    </Reveal>
    <Reveal client:visible variant="mask" delay={0.08}>
      <h2
        class="mt-7 font-display text-3xl font-medium tracking-tight md:text-5xl"
      >
        {content.heading}
      </h2>
    </Reveal>
    {
      content.body.map((paragraph, index) => (
        <Reveal client:visible delay={0.16 + index * 0.1}>
          <p class="mt-8 text-base leading-relaxed text-muted md:text-lg">
            {paragraph}
          </p>
        </Reveal>
      ))
    }
  </div>
</section>