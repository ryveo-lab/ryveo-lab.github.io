---
import { Reveal } from '../components/Reveal';
import type { PhilosophyCopy } from '../i18n/content';

interface Props {
  content: PhilosophyCopy;
}

const { content } = Astro.props;
const lastLine = content.lines.length - 1;
---

<section id="philosophy" class="scroll-mt-16 px-5 py-28 md:py-44">
  <div class="mx-auto max-w-5xl text-center">
    <Reveal client:visible>
      <h2
        class="font-display text-[clamp(2rem,_6vw,_4.5rem)] font-medium leading-[1.14] tracking-tight"
      >
        {
          content.lines.map((line, index) => (
            <span class="block">
              {index === lastLine ? <span class="gradient-text">{line}</span> : line}
            </span>
          ))
        }
      </h2>
    </Reveal>
    <Reveal client:visible delay={0.18}>
      <p class="mx-auto mt-9 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
        {content.note}
      </p>
    </Reveal>
  </div>
</section>
