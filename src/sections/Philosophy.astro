---
import { Reveal } from '../components/Reveal';
import type { PhilosophyCopy } from '../i18n/content';

interface Props {
  content: PhilosophyCopy;
}

const { content } = Astro.props;
const lastLine = content.lines.length - 1;
---

<section id="philosophy" class="scroll-mt-28 relative overflow-hidden px-5 py-36 md:py-52">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-1/2 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
    style="background: radial-gradient(closest-side, var(--hero-glow-b), transparent 72%)"
  ></div>
  <div class="relative mx-auto max-w-5xl text-center">
    <Reveal client:visible>
      <p class="kicker mx-auto w-fit">{content.kicker}</p>
    </Reveal>
    <Reveal client:visible as="span" className="mt-3 block">
      <h2
        class="font-display text-[clamp(2.1rem,_6.5vw,_5rem)] font-medium leading-[1.12] tracking-tight"
      >
        {
          content.lines.map((line, index) => (
            <Reveal
              client:visible
              as="span"
              variant="mask"
              delay={0.12 + index * 0.14}
              className="block overflow-hidden"
            >
              <span class="block">
                {index === lastLine ? <span class="gradient-text">{line}</span> : line}
              </span>
            </Reveal>
          ))
        }
      </h2>
    </Reveal>
    <Reveal client:visible delay={0.34}>
      <p class="mx-auto mt-11 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
        {content.note}
      </p>
    </Reveal>
  </div>
</section>