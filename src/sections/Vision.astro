---
import { Reveal } from '../components/Reveal';
import type { VisionCopy } from '../i18n/content';

interface Props {
  content: VisionCopy;
}

const { content } = Astro.props;
---

<section id="vision" class="scroll-mt-28 px-5 py-32 md:px-8 md:py-44">
  <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-[1.3fr_1fr] md:gap-20">
    <div>
      <Reveal client:visible>
        <p class="kicker">{content.kicker}</p>
      </Reveal>
      <Reveal client:visible variant="mask" delay={0.08}>
        <h2
          class="mt-7 font-display text-4xl font-medium leading-[1.15] tracking-tight md:text-6xl"
        >
          {content.heading}
        </h2>
      </Reveal>
    </div>
    <div class="flex flex-col justify-end gap-6 border-l border-line pl-7 md:pl-10">
      {
        content.body.map((paragraph, index) => (
          <Reveal client:visible delay={0.14 + index * 0.14}>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              {paragraph}
            </p>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>