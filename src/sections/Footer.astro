---
import type { FooterCopy, NavLink } from '../i18n/content';
import { ORG_URL } from '../i18n/content';
import type { UiStrings } from '../i18n/ui';

interface Props {
  content: FooterCopy;
  links: NavLink[];
  otherLocaleHref: string;
  /** 社区页地址：/community/（中文站）或 /en/community/（英文站）。 */
  communityHref: string;
  ui: UiStrings;
}

const { content, links, otherLocaleHref, communityHref, ui } = Astro.props;
---

<footer class="border-t border-line px-5 py-20 md:px-8">
  <div
    class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1.4fr_1fr_1fr]"
  >
    <div class="flex max-w-xs flex-col gap-3">
      <a href="/" class="flex items-center gap-2.5" aria-label="RYVEO LAB">
        <img
          src="/brand/ryveo-mark.png"
          alt=""
          width={38}
          height={23}
          class="h-5 w-8 rounded-[4px] object-cover"
        />
        <span class="text-[15px] font-semibold tracking-tight">RYVEO LAB</span>
      </a>
      <p class="text-sm leading-relaxed text-muted">{content.tagline}</p>
    </div>

    <nav aria-label={ui.footerNavLabel}>
      <p class="text-xs text-muted">{ui.footerExploreLabel}</p>
      <ul class="mt-4 flex flex-col gap-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted transition-colors hover:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-xs text-muted">{ui.footerConnectLabel}</p>
      <ul class="mt-4 flex flex-col gap-3">
        <li>
          <a
            href={ORG_URL}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-muted transition-colors hover:text-foreground"
          >
            {content.githubLabel} ↗
          </a>
        </li>
        <li>
          <a
            href={communityHref}
            class="text-sm text-muted transition-colors hover:text-foreground"
          >
            {content.communityLabel}
          </a>
        </li>
        <li>
          <a
            href={otherLocaleHref}
            class="text-sm text-muted transition-colors hover:text-foreground"
          >
            {ui.switchLang}
          </a>
        </li>
        <li>
          <a
            href="#hero"
            class="text-sm text-muted transition-colors hover:text-foreground"
          >
            {content.backToTop} ↑
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>