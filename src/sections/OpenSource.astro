---
import { Reveal } from '../components/Reveal';
import type { OpenSourceCopy } from '../i18n/content';
import { ORG_URL } from '../i18n/content';

interface Props {
  content: OpenSourceCopy;
}

const { content } = Astro.props;
---

<section id="opensource" class="scroll-mt-16 px-5 py-28 md:px-8 md:py-36">
  <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-[1.2fr_0.8fr] md:gap-20">
    <div class="flex flex-col gap-6">
      <Reveal client:visible>
        <h2
          class="font-display text-4xl font-medium leading-tight tracking-tight md:text-6xl"
        >
          {content.heading}
        </h2>
      </Reveal>
      {
        content.body.map((paragraph, index) => (
          <Reveal client:visible delay={0.08 + index * 0.1}>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              {paragraph}
            </p>
          </Reveal>
        ))
      }
      <Reveal client:visible delay={0.2}>
        <a
          href={ORG_URL}
          target="_blank"
          rel="noreferrer"
          class="mt-2 inline-flex h-12 w-fit items-center gap-2 rounded-full border border-line-strong px-7 text-sm font-medium transition-colors hover:border-brand-violet/70 hover:text-brand-violet"
        >
          {content.actionLabel}
        </a>
      </Reveal>
      <Reveal client:visible delay={0.28}>
        <p class="text-xs leading-relaxed text-muted/80">{content.note}</p>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.12} y={14}>
      <aside class="rounded-2xl border border-line bg-surface/40 p-8">
        <p class="font-display text-sm font-medium tracking-wide">
          RYVEO LAB · GitHub
        </p>
        <ul class="mt-6 flex flex-col gap-5">
          <li class="flex items-baseline justify-between gap-6 border-b border-line pb-4">
            <span class="text-sm text-muted">ryveo-lab</span>
            <a
              href={ORG_URL}
              target="_blank"
              rel="noreferrer"
              class="shrink-0 text-sm text-foreground transition-colors hover:text-brand-violet"
            >
              →
            </a>
          </li>
          <li class="flex items-baseline justify-between gap-6 border-b border-line pb-4">
            <span class="text-sm text-muted">Repositories</span>
            <a
              href={`${ORG_URL}/repositories`}
              target="_blank"
              rel="noreferrer"
              class="shrink-0 text-sm text-foreground transition-colors hover:text-brand-violet"
            >
              →
            </a>
          </li>
          <li class="flex items-baseline justify-between gap-6 border-b border-line pb-4">
            <span class="text-sm text-muted">Contribution guides</span>
            <span class="shrink-0 text-xs text-muted">计划中 · Planned</span>
          </li>
          <li class="flex items-baseline justify-between gap-6">
            <span class="text-sm text-muted">Community governance</span>
            <span class="shrink-0 text-xs text-muted">计划中 · Planned</span>
          </li>
        </ul>
      </aside>
    </Reveal>
  </div>
</section>
