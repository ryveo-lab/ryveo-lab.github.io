---
import { Reveal } from '../components/Reveal';
import type { OpenSourceCopy } from '../i18n/content';
import { ORG_URL } from '../i18n/content';

interface Props {
  content: OpenSourceCopy;
}

const { content } = Astro.props;
---

<section id="opensource" class="scroll-mt-28 px-5 py-32 md:px-8 md:py-44">
  <div class="mx-auto grid max-w-6xl gap-16 md:grid-cols-[1.2fr_0.8fr] md:gap-24">
    <div class="flex flex-col gap-7">
      <Reveal client:visible>
        <p class="kicker">{content.kicker}</p>
      </Reveal>
      <Reveal client:visible variant="mask" delay={0.08}>
        <h2
          class="font-display text-4xl font-medium leading-[1.15] tracking-tight md:text-6xl"
        >
          {content.heading}
        </h2>
      </Reveal>
      {
        content.body.map((paragraph, index) => (
          <Reveal client:visible delay={0.14 + index * 0.1}>
            <p class="text-base leading-relaxed text-muted md:text-lg">
              {paragraph}
            </p>
          </Reveal>
        ))
      }
      <Reveal client:visible delay={0.22}>
        <a
          href={ORG_URL}
          target="_blank"
          rel="noreferrer"
          class="group mt-2 inline-flex h-12 w-fit items-center gap-2.5 rounded-full border border-line-strong px-7 text-sm font-medium transition-colors duration-300 hover:border-brand-violet/70 hover:text-brand-violet"
        >
          {content.actionLabel}
          <span class="transition-transform duration-300 group-hover:translate-x-0.5">
            →
          </span>
        </a>
      </Reveal>
      <Reveal client:visible delay={0.28}>
        <p class="text-xs leading-relaxed text-muted/80">{content.note}</p>
      </Reveal>
    </div>

    <Reveal client:visible delay={0.16} y={16}>
      <aside class="rounded-2xl border border-line bg-surface/40 p-8 md:p-10">
        <div class="flex items-center gap-3">
          <img
            src="/brand/favicon.png"
            alt=""
            width={32}
            height={32}
            class="h-8 w-8 rounded-md object-cover"
          />
          <div>
            <p class="font-display text-sm font-semibold tracking-tight">
              RYVEO LAB
            </p>
            <p class="mt-0.5 text-xs text-muted">GitHub · ryveo-lab</p>
          </div>
        </div>
        <ul class="mt-9 flex flex-col gap-5">
          <li class="group flex items-baseline justify-between gap-6 border-b border-line pb-4 transition-colors">
            <span class="text-sm text-muted transition-colors duration-300 group-hover:text-foreground">
              Repositories
            </span>
            <a
              href={`${ORG_URL}/repositories`}
              target="_blank"
              rel="noreferrer"
              class="shrink-0 font-mono text-sm text-muted transition-all duration-300 group-hover:translate-x-1 group-hover:text-foreground"
              aria-label="GitHub repositories"
            >
              →
            </a>
          </li>
          <li class="group flex items-baseline justify-between gap-6 border-b border-line pb-4">
            <span class="text-sm text-muted">Contribution guides</span>
            <span class="shrink-0 rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
              计划中 · Planned
            </span>
          </li>
          <li class="flex items-baseline justify-between gap-6">
            <span class="text-sm text-muted">Community governance</span>
            <span class="shrink-0 rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
              计划中 · Planned
            </span>
          </li>
        </ul>
      </aside>
    </Reveal>
  </div>
</section>